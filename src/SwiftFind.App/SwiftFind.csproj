<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>SwiftFind</RootNamespace>
    <AssemblyName>SwiftFind</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>SwiftFind</AssemblyTitle>
    <Product>SwiftFind</Product>
    <Company>Bravo Company Cyber</Company>
    <Description>Professional instant desktop search and Explorer-like file manager for Windows 8–11</Description>
    <Copyright>Copyright © 2026</Copyright>
    <Version>2.6.1</Version>
    <FileVersion>2.6.1</FileVersion>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>$(MSBuildThisFileDirectory)..\..\</OutputPath>
    <ApplicationIcon Condition="Exists('..\..\assets\SwiftFind.ico')">..\..\assets\SwiftFind.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="Microsoft.CSharp" />
  </ItemGroup>

</Project>
