<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <RootNamespace>SwiftFind</RootNamespace>
    <AssemblyName>SwiftFind</AssemblyName>
    <UseWindowsForms>true</UseWindowsForms>
    <LangVersion>7.3</LangVersion>
    <Nullable>disable</Nullable>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <StartupObject>SwiftFind.Program</StartupObject>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>..\..\assets\SwiftFind.ico</ApplicationIcon>

    <GenerateAssemblyInfo>true</GenerateAssemblyInfo>
    <AssemblyTitle>SwiftFind</AssemblyTitle>
    <Product>SwiftFind</Product>
    <Company>Bravo Company Cyber</Company>
    <Description>Fast desktop search and indexing for Windows - instant file search with an NTFS fast index</Description>
    <Copyright>Copyright (c) 2026</Copyright>
    <Version>3.0.0</Version>
    <FileVersion>3.0.0</FileVersion>

    <!-- Normal bin/obj output. Build artifacts must never be written into the repository root. -->
    <DebugType>pdbonly</DebugType>
  </PropertyGroup>

  <ItemGroup>
    <!-- Brand assets are embedded so the exe is a single self-contained file. -->
    <EmbeddedResource Include="..\..\assets\SwiftFind.ico" LogicalName="SwiftFind.ico" />
    <EmbeddedResource Include="..\..\assets\logo_256.png" LogicalName="logo.png" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="Microsoft.VisualBasic" />
  </ItemGroup>

</Project>
